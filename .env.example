# 정액제 구독 인증. `claude setup-token`으로 발급한 1년짜리 토큰.
# 로컬 개발에서 `claude` 로그인 세션을 쓴다면 비워 둬도 된다.
CLAUDE_CODE_OAUTH_TOKEN=

# 추출 모델. 비우면 claude-sonnet-5.
RECRUIT_MODEL=

# 하루 모델 호출 상한. 넘으면 과금으로 넘어가지 않고 멈춘다.
RECRUIT_DAILY_CALL_LIMIT=30

# 주의: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 은 여기에 두지 않는다.
# 구독 토큰보다 우선순위가 높아 구독 인증을 무력화하고 종량 과금된다.
# 설정돼 있으면 부팅이 중단된다 (adapters/llm/guards.mjs).
