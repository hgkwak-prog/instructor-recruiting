# ── Claude (정액제 구독) ──────────────────────────────────────────────
# `claude setup-token`으로 발급한 1년짜리 토큰.
CLAUDE_CODE_OAUTH_TOKEN=
# 발급일. 만료 경고가 뜨지 않는 토큰이라 이 값으로 남은 날짜를 센다(/readyz).
CLAUDE_CODE_OAUTH_TOKEN_ISSUED_AT=2026-08-24
RECRUIT_MODEL=
RECRUIT_DAILY_CALL_LIMIT=30

# 주의: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 은 두지 않는다.
# 구독 토큰보다 우선순위가 높아 구독 인증을 무력화하고 종량 과금된다.
# 설정돼 있으면 부팅이 중단된다.

# ── Slack ────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# 기본 게시 채널. 승인 화면에서 건별로 바꿀 수 있다.
SLACK_CHANNEL_ID=

# slack = 실제 게시 / clipboard = 쏘지 않고 흐름만 확인
PUBLISH_MODE=slack

# ── 운영 ─────────────────────────────────────────────────────────────
# 커리큘럼에 없는 사실(장소·인원·지원방법 등)을 담당자가 선언하는 파일.
RECRUIT_CONDITIONS_PATH=./examples/operating-conditions.json
RECRUIT_DATA_DIR=
HEALTH_PORT=3000

# ── 현황 확인 알림 ────────────────────────────────────────────────────
RECRUITMENT_WAIT_DAYS=3
RECRUITMENT_DAY_MODE=business
RECRUITMENT_REMINDER_POLL_MS=300000
RECRUITMENT_TIME_ZONE=Asia/Seoul

# ── 커리어데이 (호스트에서만 실행) ────────────────────────────────────
CAREERDAY_CREATE_URL=https://www.careerday.jobs/enterprise/recruitments/new
CAREERDAY_BROWSER_PROFILE=
